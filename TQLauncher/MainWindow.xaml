<Window x:Class="TinyQuakeLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tiny Quake Launcher"
        Width="500"
        Height="430"
        WindowStartupLocation="CenterScreen"
        Background="#F2F2F2">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Quake folder -->

        <Grid Grid.Row="0" Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="85"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Quake folder:"
                VerticalAlignment="Center"/>

            <TextBox
                x:Name="QuakeFolderTextBox"
                Grid.Column="1"
                Height="26"
                Margin="0,0,8,0"
                VerticalContentAlignment="Center"/>

            <Button
                x:Name="BrowseButton"
                Grid.Column="2"
                Content="Browse..."
                Height="26"
                Click="BrowseButton_Click"/>

        </Grid>

        <!-- Engine -->

        <Grid Grid.Row="1" Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Engine:"
                VerticalAlignment="Center"/>

            <ComboBox
                x:Name="EngineComboBox"
                Background="#F2F2F2"
                Grid.Column="1"
                Height="26"
                SelectionChanged="EngineComboBox_SelectionChanged"/>

        </Grid>

        <!-- Mission pack -->

        <Grid Grid.Row="2" Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Episode:"
                VerticalAlignment="Center"/>

            <ComboBox
                x:Name="MissionComboBox"
                Background="#F2F2F2"
                Grid.Column="1"
                Height="26"
                SelectionChanged="MissionComboBox_SelectionChanged"/>

        </Grid>

        <!-- Map -->

        <Grid Grid.Row="3" Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Map:"
                VerticalAlignment="Center"/>

            <ComboBox
                x:Name="MapComboBox"
                Background="#F2F2F2"
                Grid.Column="1"
                Height="26"
                SelectionChanged="MapComboBox_SelectionChanged"/>

        </Grid>
        
        <!-- Command arguments -->

        <Grid Grid.Row="4" Margin="0,0,0,15">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="Command arguments:"
                Margin="0,0,0,5"/>

            <TextBox
                x:Name="CommandArgumentsTextBox"
                Grid.Row="1"
                Height="55"
                IsReadOnly="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"
                VerticalContentAlignment="Top"
                Padding="8"
                Background="#FFFFFF"
                BorderBrush="#666666"/>

        </Grid>

        <!-- Launch -->

        <Button
            x:Name="LaunchButton"
            Grid.Row="5"
            Content="LAUNCH QUAKE"
            Height="45"
            Margin="0,10,0,15"
            FontSize="18"
            FontWeight="Bold"
            Click="LaunchButton_Click"/>

        <!-- Bottom status bar -->

        <Grid Grid.Row="6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="StatusText"
                Grid.Column="0"
                Text="Status: Select your Quake folder."
                FontSize="13"
                VerticalAlignment="Center"/>

            <TextBlock
                Grid.Column="1"
                Text="v0.2"
                FontSize="13"
                Foreground="#B0B0B0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"/>

        </Grid>

    </Grid>

</Window>