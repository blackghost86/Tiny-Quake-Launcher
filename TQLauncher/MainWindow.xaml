<Window x:Class="TinyQuakeLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tiny Quake Launcher"
        Width="400"
        Height="530"
        WindowStartupLocation="CenterScreen"
        Background="#F2F2F2">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Quake folder -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="Quake folder:"
                VerticalAlignment="Center"/>
            <TextBox
                x:Name="QuakeFolderTextBox"
                Grid.Column="1"
                Height="26"
                Margin="0,0,6,0"
                VerticalContentAlignment="Center"/>
            <Button
                x:Name="BrowseButton"
                Grid.Column="2"
                Content="📁"
                FontSize="13"
                Width="40"
                Height="26"
                ToolTip="Browse Quake folder"
                Click="BrowseButton_Click"/>
        </Grid>

        <!-- Engine -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="Engine:"
                VerticalAlignment="Center"/>
            <ComboBox
                x:Name="EngineComboBox"
                Background="#F2F2F2"
                Grid.Column="1"
                Height="26"
                SelectionChanged="EngineComboBox_SelectionChanged"/>
        </Grid>

        <!-- Episode -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="Episode:"
                VerticalAlignment="Center"/>
            <ComboBox 
                x:Name="MissionComboBox"
                Background="#F2F2F2"
                Grid.Column="1"
                Height="26"
                SelectionChanged="MissionComboBox_SelectionChanged"/>
        </Grid>

        <!-- Map -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="Map:"
                VerticalAlignment="Center"/>
            <ComboBox
                x:Name="MapComboBox"
                Background="#F2F2F2"
                Grid.Column="1"
                Height="26"
                SelectionChanged="MapComboBox_SelectionChanged"/>
        </Grid>

        <!-- Difficulty -->
        <Grid Grid.Row="4" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="Difficulty:"
                VerticalAlignment="Center"/>
            <ComboBox
                x:Name="DifficultyComboBox"
                Background="#F2F2F2"
                Grid.Column="1"
                Height="26"
                SelectionChanged="DifficultyComboBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- Command arguments -->
        <Grid Grid.Row="5" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Text="Command line arguments:"
                Margin="0,0,0,5"/>
            <TextBox
                x:Name="CommandArgumentsTextBox"
                Grid.Row="1"
                Height="55"
                IsReadOnly="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"
                VerticalContentAlignment="Top"
                Padding="8"
                Background="#FFFFFF"
                BorderBrush="#666666"/>
        </Grid>

        <!-- Extra arguments -->

        <Grid Grid.Row="6" Margin="0,0,0,15">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="Extra arguments:"
                Margin="0,0,0,5"/>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Manual extra arguments -->

                <TextBox
                    x:Name="ExtraArgumentsTextBox"
                    Grid.Column="0"
                    Height="55"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                    VerticalContentAlignment="Top"
                    Padding="8"
                    Margin="0,0,6,0"
                    Background="#FFFFFF"
                    BorderBrush="#666666"
                    ToolTip="Optional arguments added to the general command line"
                    TextChanged="ExtraArgumentsTextBox_TextChanged"/>

                <!-- Action buttons -->

                <StackPanel
                    Grid.Column="1"
                    Orientation="Vertical">

                    <!-- Clear extra arguments -->

                    <Button
                        x:Name="ClearExtraArgumentsButton"
                        Width="38"
                        Height="26"
                        Margin="0,0,0,3"
                        Content="✖"
                        FontSize="15"
                        Foreground="Red"
                        ToolTip="Clear extra arguments"
                        Click="ClearExtraArgumentsButton_Click"/>

                    <!-- Desktop shortcut -->

                    <Button
                        x:Name="CreateDesktopShortcutButton"
                        Width="38"
                        Height="26"
                        Content="🔗"
                        FontSize="15"
                        ToolTip="Create desktop shortcut"
                        Click="CreateDesktopShortcutButton_Click"/>

                </StackPanel>

            </Grid>

        </Grid>

        <!-- Launch -->
        <Button
            x:Name="LaunchButton"
            Grid.Row="7"
            Content="LAUNCH QUAKE"
            Height="45"
            Margin="0,10,0,15"
            FontSize="18"
            FontWeight="Bold"
            Click="LaunchButton_Click"/>

        <!-- Bottom status bar -->
        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StatusText"
                Grid.Column="0"
                Text="Select your Quake folder."
                VerticalAlignment="Center"/>
            <TextBlock
                Grid.Column="1"
                Text="v0.6"
                FontWeight="Bold"
                Foreground="#B0B0B0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"/>
        </Grid>

    </Grid>
</Window>