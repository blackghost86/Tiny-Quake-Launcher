<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>

		<ApplicationIcon>TQLauncher.ico</ApplicationIcon>

		<!-- Application information -->
		<ApplicationTitle>Tiny Quake Launcher</ApplicationTitle>
		<AssemblyTitle>Tiny Quake Launcher</AssemblyTitle>
		<AssemblyName>Tiny Quake Launcher</AssemblyName>
		<Product>Tiny Quake Launcher</Product>
		<Description>Tiny Quake Launcher.</Description>
		<Copyright>Copyright © 2026 TQLauncher</Copyright>

		<!-- Version -->
		<AssemblyVersion>0.9.3.0</AssemblyVersion>
		<FileVersion>0.9.3.0</FileVersion>
		<InformationalVersion>0.9.3</InformationalVersion>

		<!-- Framework-dependent single-file publish -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>

		<!-- Don't generate debugging symbols for published app -->
		<DebugType>None</DebugType>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>

</Project>